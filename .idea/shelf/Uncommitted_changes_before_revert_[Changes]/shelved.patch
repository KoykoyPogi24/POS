+package com.example.pos;
+
+import android.content.Intent;
+import android.os.Bundle;
+import android.text.Editable;
+import android.text.TextWatcher;
+import android.view.View;
+import android.widget.Toast;
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AppCompatActivity;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+import com.google.android.material.button.MaterialButton;
+import com.google.android.material.textfield.TextInputEditText;
+import com.journeyapps.barcodescanner.ScanContract;
+import com.journeyapps.barcodescanner.ScanOptions;
+import java.util.ArrayList;
+import java.util.List;
+import androidx.core.content.ContextCompat;
+
+public class CashierPosActivity extends AppCompatActivity {
+    private TextInputEditText etBarcode, etProductSearch;
+    private MaterialButton btnAddBarcode, btnScanCamera;
+    private RecyclerView rvProducts, rvCart;
+    private ProductAdapter productAdapter;
+    private CartAdapter cartAdapter;
+    private List<Product> allProducts = new ArrayList<>();
+    private List<Product> filteredProducts = new ArrayList<>();
+    private List<CartItem> cartItems = new ArrayList<>();
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_pos);
+        initViews();
+        loadProducts();
+        setupListeners();
+        updateCartUI();
+    }
+
+    private void initViews() {
+        etBarcode = findViewById(R.id.etBarcode);
+        etProductSearch = findViewById(R.id.etProductSearch);
+        btnAddBarcode = findViewById(R.id.btnAddBarcode);
+        btnScanCamera = findViewById(R.id.btnScanCamera);
+        rvProducts = findViewById(R.id.rvProducts);
+        rvCart = findViewById(R.id.rvCart);
+        rvProducts.setLayoutManager(new LinearLayoutManager(this));
+        rvCart.setLayoutManager(new LinearLayoutManager(this));
+        productAdapter = new ProductAdapter(filteredProducts, this::addToCart);
+        rvProducts.setAdapter(productAdapter);
+        cartAdapter = new CartAdapter(cartItems, this::removeFromCart);
+        rvCart.setAdapter(cartAdapter);
+    }
+
+    private void loadProducts() {
+        // TODO: Load products from your database or static list
+        allProducts.clear();
+        allProducts.add(new Product("8904182011293", "Handwoven Basket (Large)", "Handicrafts", 450, 15));
+        allProducts.add(new Product("2345678901234", "Local Honey (500ml)", "Food", 220, 25));
+        allProducts.add(new Product("3456789012345", "Embroidered Shirt (M)", "Clothing", 550, 8));
+        filteredProducts.clear();
+        filteredProducts.addAll(allProducts);
+        productAdapter.notifyDataSetChanged();
+    }
+
+    private void setupListeners() {
+        btnAddBarcode.setOnClickListener(v -> handleBarcodeEntry());
+        etBarcode.setOnEditorActionListener((v, actionId, event) -> {
+            handleBarcodeEntry();
+            return true;
+        });
+        btnScanCamera.setOnClickListener(v -> launchBarcodeScanner());
+        etProductSearch.addTextChangedListener(new TextWatcher() {
+            @Override public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
+            @Override public void onTextChanged(CharSequence s, int start, int before, int count) {
+                filterProducts(s.toString());
+            }
+            @Override public void afterTextChanged(Editable s) {}
+        });
+    }
+
+    private void handleBarcodeEntry() {
+        String code = etBarcode.getText().toString().trim();
+        if (!code.isEmpty()) {
+            addProductByBarcode(code);
+            etBarcode.setText("");
+        }
+    }
+
+    private void addProductByBarcode(String barcode) {
+        for (Product p : allProducts) {
+            if (p.getBarcode().equals(barcode)) {
+                addToCart(p);
+                Toast.makeText(this, "Added to cart: " + p.getName(), Toast.LENGTH_SHORT).show();
+                return;
+            }
+        }
+        Toast.makeText(this, "Product not found for barcode: " + barcode, Toast.LENGTH_SHORT).show();
+    }
+
+    private void filterProducts(String query) {
+        filteredProducts.clear();
+        if (query.isEmpty()) {
+            filteredProducts.addAll(allProducts);
+        } else {
+            for (Product p : allProducts) {
+                if (p.getName().toLowerCase().contains(query.toLowerCase()) ||
+                    p.getBarcode().contains(query) ||
+                    p.getCategory().toLowerCase().contains(query.toLowerCase())) {
+                    filteredProducts.add(p);
+                }
+            }
+        }
+        productAdapter.notifyDataSetChanged();
+    }
+
+    private void addToCart(Product product) {
+        for (CartItem item : cartItems) {
+            if (item.getProduct().getBarcode().equals(product.getBarcode())) {
+                item.incrementQuantity();
+                cartAdapter.notifyDataSetChanged();
+                updateCartUI();
+                return;
+            }
+        }
+        cartItems.add(new CartItem(product, 1));
+        cartAdapter.notifyDataSetChanged();
+        updateCartUI();
+    }
+
+    private void removeFromCart(CartItem item) {
+        cartItems.remove(item);
+        cartAdapter.notifyDataSetChanged();
+        updateCartUI();
+    }
+
+    private void updateCartUI() {
+        findViewById(R.id.tvCartTitle).setVisibility(View.VISIBLE);
+        if (cartItems.isEmpty()) {
+            findViewById(R.id.tvCartEmpty).setVisibility(View.VISIBLE);
+            rvCart.setVisibility(View.GONE);
+        } else {
+            findViewById(R.id.tvCartEmpty).setVisibility(View.GONE);
+            rvCart.setVisibility(View.VISIBLE);
+        }
+        ((android.widget.TextView)findViewById(R.id.tvCartTitle)).setText("Shopping Cart (" + cartItems.size() + ")");
+    }
+
+    // ZXing barcode scanner integration
+    private final androidx.activity.result.ActivityResultLauncher<ScanOptions> barcodeLauncher = registerForActivityResult(
+            new ScanContract(),
+            result -> {
+                if (result.getContents() != null) {
+                    addProductByBarcode(result.getContents());
+                }
+            });
+
+    private void launchBarcodeScanner() {
+        ScanOptions options = new ScanOptions();
+        options.setPrompt("Scan a barcode");
+        options.setBeepEnabled(true);
+        options.setOrientationLocked(false);
+        options.setCameraId(0);
+        barcodeLauncher.launch(options);
+    }
+
+    // --- Product and CartItem classes for demo ---
+    public static class Product {
+        private final String barcode, name, category;
+        private final double price;
+        private int stock;
+        public Product(String barcode, String name, String category, double price, int stock) {
+            this.barcode = barcode; this.name = name; this.category = category; this.price = price; this.stock = stock;
+        }
+        public String getBarcode() { return barcode; }
+        public String getName() { return name; }
+        public String getCategory() { return category; }
+        public double getPrice() { return price; }
+        public int getStock() { return stock; }
+    }
+    public static class CartItem {
